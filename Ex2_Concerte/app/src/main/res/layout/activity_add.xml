<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".AddActivity">

    <EditText
        android:id="@+id/etArtist"
        android:layout_width="298dp"
        android:layout_height="66dp"
        android:ems="10"
        android:hint="Artist"
        android:inputType="text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/etData"
        android:layout_width="303dp"
        android:layout_height="57dp"
        android:ems="10"
        android:hint="MM/dd/yyyy"
        android:inputType="date"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/etArtist" />

    <EditText
        android:id="@+id/etNrBileteCumparate"
        android:layout_width="312dp"
        android:layout_height="67dp"
        android:ems="10"
        android:hint="Numar bilete"
        android:inputType="number"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/etData" />

    <Spinner
        android:id="@+id/spinnerGen"
        android:layout_width="231dp"
        android:layout_height="50dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tvSoldOut"
        app:layout_constraintTop_toBottomOf="@+id/etNrBileteCumparate" />

    <TextView
        android:id="@+id/tvGen"
        android:layout_width="104dp"
        android:layout_height="27dp"
        android:layout_marginEnd="28dp"
        android:text="Gen muzical"
        app:layout_constraintBottom_toTopOf="@+id/tvSoldOut"
        app:layout_constraintEnd_toStartOf="@+id/spinnerGen"
        app:layout_constraintStart_toStartOf="parent" />

    <RadioGroup
        android:id="@+id/radioGroup"
        android:layout_width="143dp"
        android:layout_height="129dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/spinnerGen">

        <RadioButton
            android:id="@+id/rbNu"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="Nu" />

        <RadioButton
            android:id="@+id/rbDa"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="Da" />
    </RadioGroup>

    <TextView
        android:id="@+id/tvSoldOut"
        android:layout_width="96dp"
        android:layout_height="32dp"
        android:layout_marginBottom="180dp"
        android:text="@string/soldout"
        app:layout_constraintBottom_toTopOf="@+id/btnAdd"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/btnAdd"
        android:layout_width="371dp"
        android:layout_height="59dp"
        android:layout_marginTop="50dp"
        android:text="@string/adauga_concert"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/radioGroup" />
</androidx.constraintlayout.widget.ConstraintLayout>