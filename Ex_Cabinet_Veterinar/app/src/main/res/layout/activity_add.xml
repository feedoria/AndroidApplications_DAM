<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    tools:context=".AddActivity">

    <EditText
        android:id="@+id/etNume"
        android:layout_width="350dp"
        android:layout_height="50dp"
        android:layout_marginStart="23dp"
        android:layout_marginTop="40dp"
        android:ems="10"
        android:hint="Nume"
        android:inputType="text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/etRasa"
        android:layout_width="350dp"
        android:layout_height="55dp"
        android:layout_marginStart="25dp"
        android:layout_marginTop="26dp"
        android:ems="10"
        android:hint="Rasa"
        android:inputType="text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/etNume" />

    <EditText
        android:id="@+id/etData"
        android:layout_width="362dp"
        android:layout_height="61dp"
        android:layout_marginStart="22dp"
        android:layout_marginTop="39dp"
        android:ems="10"
        android:hint="MM/dd/yyyy"
        android:inputType="date"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/etRasa" />

    <EditText
        android:id="@+id/etGreutate"
        android:layout_width="373dp"
        android:layout_height="48dp"
        android:layout_marginStart="17dp"
        android:layout_marginTop="31dp"
        android:ems="10"
        android:hint="Greutate"
        android:inputType="numberDecimal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/etData" />

    <CheckBox
        android:id="@+id/cbVaccinat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:layout_marginTop="50dp"
        android:text="Vaccinat?"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/etGreutate" />

    <Button
        android:id="@+id/btnAdauga"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="145dp"
        android:layout_marginTop="180dp"
        android:text="Adauga"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/etGreutate" />

</androidx.constraintlayout.widget.ConstraintLayout>